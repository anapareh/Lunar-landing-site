{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunarnav.local/schemas/horizon.schema.json",
  "title": "horizons/<site_id>.json (contrato v1)",
  "description": "Perfil de horizonte local. La relación length == 360 / azimuth_step_deg se comprueba en los tests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "site_id", "lat", "lon", "surface_height_m", "observer_height_m",
    "azimuth_step_deg", "horizon_elevation_deg", "max_distance_km", "dem", "method_version"
  ],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "site_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "parent_site_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "surface_height_m": { "type": ["number", "null"] },
    "observer_height_m": { "type": "number", "minimum": 0 },
    "azimuth_step_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 360 },
    "horizon_elevation_deg": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number", "minimum": -90, "maximum": 90 }
    },
    "max_distance_km": { "type": "number", "exclusiveMinimum": 0 },
    "dem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "resolution_m", "source_url"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "resolution_m": { "type": "number", "exclusiveMinimum": 0 },
        "source_url": { "type": ["string", "null"] }
      }
    },
    "method_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
  }
}
